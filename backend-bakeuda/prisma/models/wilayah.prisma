model Wilayah {
  // kode_wilayah = gabungan propinsi+dati2+kecamatan+kelurahan (10 digit)
  kode_wilayah String @id @db.VarChar(10)

  kode_propinsi String @db.VarChar(2)
  nama_propinsi String @default("Jawa Tengah") @db.VarChar(50)

  kode_dati2 String @db.VarChar(2)
  kabupaten  String @default("Purbalingga") @db.VarChar(100)

  kode_kecamatan String @db.VarChar(3)
  kecamatan      String @db.VarChar(100)

  kode_kelurahan String @db.VarChar(3)
  nama_desa      String @db.VarChar(100)

  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // ── Relasi ──
  users        User[]
  pejabat      PejabatDesa[]
  objek_pajak  ObjekPajak[]
  blok         ReferensiBlok[]

  kode_sektor String? @db.VarChar(2)
  sektor      Sektor? @relation(fields: [kode_sektor], references: [kode_sektor])

  @@unique([kode_propinsi, kode_dati2, kode_kecamatan, kode_kelurahan])
  @@index([kode_kecamatan])
  @@map("wilayah")
}

model ReferensiBlok {
  id_blok      String   @id @default(uuid())
  kode_wilayah String   @db.VarChar(10) // FK ke Wilayah
  kode_blok    String   @db.VarChar(3)
  keterangan   String?  @db.VarChar(100)
  sumber_data  String   @default("MANUAL") // "MANUAL" atau "ORACLE_SYNC"
  created_at   DateTime @default(now())

  wilayah Wilayah @relation(fields: [kode_wilayah], references: [kode_wilayah])

  @@unique([kode_wilayah, kode_blok])
  @@index([kode_wilayah])
  @@map("referensi_blok")
}
